{
  "name": "russian-nouns-js",
  "version": "3.0.0-alpha.0",
  "description": "Declension by cases. Pluralization.",
  "type": "module",
  "main": "dist/RussianNouns.cjs",
  "module": "dist/RussianNouns.mjs",
  "exports": {
    "import": "./dist/RussianNouns.mjs",
    "require": "./dist/RussianNouns.cjs",
    "browser": "./dist/RussianNouns.umd.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "postbuild": "duk node_modules/core-js-bundle/minified.js dist/RussianNouns.es5.js dukTest.js",
    "dev": "rollup -c -w",
    "prepublishOnly": "npm run build",
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/georgy7/RussianNounsJS.git"
  },
  "keywords": [
    "Russian",
    "inflection",
    "падежи",
    "склонение-слов"
  ],
  "author": "Georgy Ustinov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/georgy7/RussianNounsJS/issues"
  },
  "homepage": "https://georgy7.github.io/RussianNounsJS/",
  "devDependencies": {
    "rollup": "^4.57.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-babel": "^6.1.0",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@rollup/plugin-terser": "^0.4.4",
    "core-js-bundle": "^3.48.0"
  }
}
